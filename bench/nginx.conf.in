# Benchmark configuration shared by nginx and zhttpd (rendered to bench/nginx.conf by
# bench/run.sh: @ROOT@, @PORT@, @TLSPORT@ are substituted). nginx is fully tuned;
# directives zhttpd does not implement are accepted with a warning (see zhttpd -t).
worker_processes auto;
worker_rlimit_nofile 65535;
error_log logs/error.log warn;
pid logs/bench.pid;

events {
    worker_connections 16384;
    use kqueue;            # epoll on Linux: drop this line, both servers pick the best backend
    multi_accept on;
    accept_mutex off;
}

http {
    include @ROOT@/tests/fixtures/nginx-default/mime.types;
    default_type application/octet-stream;

    access_log off;
    server_tokens off;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    keepalive_timeout 65;
    keepalive_requests 1000000;

    open_file_cache max=10000 inactive=60s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;

    server {
        listen @PORT@ reuseport backlog=4096 default_server;
        listen @TLSPORT@ ssl reuseport backlog=4096 default_server;
        http2 off;
        server_name localhost;

        ssl_certificate @ROOT@/bench/certs/cert.pem;
        ssl_certificate_key @ROOT@/bench/certs/key.pem;
        ssl_protocols TLSv1.3;
        ssl_session_cache shared:SSL:50m;
        ssl_session_timeout 1h;
        ssl_session_tickets on;

        root @ROOT@/bench/www;

        location / {
            try_files $uri =404;
        }

        # HttpArena "baseline": tiny dynamic plaintext answer
        location = /baseline11 {
            default_type text/plain;
            return 200 "3";
        }
    }
}
